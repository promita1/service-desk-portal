{
  "realm": "servicedesk",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "requester", "description": "Can create and view own tickets" },
      { "name": "agent", "description": "Can view all tickets and resolve or close them" }
    ]
  },
  "clients": [
    {
      "clientId": "servicedesk-spa",
      "name": "Service Desk SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "servicedesk-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Requester",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice_dev_pw", "temporary": false }],
      "realmRoles": ["requester"]
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob_dev_pw", "temporary": false }],
      "realmRoles": ["agent"]
    }
  ]
}